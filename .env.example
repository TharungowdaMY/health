# Copy to .env and change every value marked CHANGE ME. Never commit .env.

# --- PostgreSQL ---
POSTGRES_USER=delta
# CHANGE ME. Use letters/digits only (it is embedded in a URL), e.g.:
#   python -c "import secrets; print(secrets.token_hex(16))"
POSTGRES_PASSWORD=change_me_please
POSTGRES_DB=delta_health

# --- App ---
# "development" or "production". Production refuses weak secrets.
DELTA_HEALTH_ENV=development
# CHANGE ME. 32+ random chars:
#   python -c "import secrets; print(secrets.token_hex(32))"
DELTA_HEALTH_SECRET=change_me_to_a_long_random_string_of_32_plus_chars

# Seed synthetic demo clinics/patients/logins on first start (true/false).
# Demo logins are public knowledge (clinic1/clinic123, healthofficer/admin123):
# only enable for a demo deployment holding synthetic data.
SEED_DEMO_DATA=true

# --- Only for docker-compose.prod.yml (HTTPS via Caddy) ---
# DOMAIN=delta.example.com
